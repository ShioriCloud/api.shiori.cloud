APP_PORT=3000
APP_HOST=0.0.0.0
APP_ALLOW_ORIGINS=https://shiori.cloud,https://dash.shiori.cloud,http://localhost:5173

# Postgres
# ── Local dev (API on host, DB in docker-compose.yml): ──
# DATABASE_URL=postgresql://shiori:shiori@localhost:15432/shiori
#
# ── Production Docker (docker-compose.prod.yml): leave unset or comment out —
# compose sets DATABASE_URL=...@postgres:5432 automatically.
# DATABASE_URL=

# Never enable in production against a live DB
DATABASE_SYNC=false

# Telegram Mini App — verify initData (BotFather token for @ShioriMiniBot)
TELEGRAM_BOT_TOKEN=
# Optional extra bot tokens (comma-separated)
# TELEGRAM_BOT_TOKENS=
# Optional: separate token if mini-app bot differs from TELEGRAM_BOT_TOKEN
# TELEGRAM_MINI_APP_BOT_TOKEN=

# نام کاربری بات آپلود/فایل
# TELEGRAM_BOT_USERNAME=ShioriUploadBot
# بات میزبان مینی‌اپ (لینک‌های startapp)
# TELEGRAM_MINI_APP_BOT_USERNAME=ShioriMiniBot

# URL مینی‌اپ برای دکمه «مشاهده در شیوری» در اعلان Telegram
# MINI_APP_URL=https://your-shiori-app.example.com

# Cron — external score sync
# CRON_SECRET=your-random-secret

# Local dev only — Windows/corporate networks may fail TLS verification for external score APIs
# EXTERNAL_SCORES_INSECURE_TLS=true
# (legacy alias still supported: EXTERNAL_SCORES_JIKAN_INSECURE_TLS=true)

# Optional — when system DNS returns private/filtered IPs (e.g. 10.x for blocked domains)
# EXTERNAL_SCORES_DNS_SERVERS=8.8.8.8,1.1.1.1

# Telegram bot backend API (tel-bot → x-bot-token header)
BOT_API_TOKEN='n~cJO/jry6^&DU1wHFP^un4Jxvg-9[w4'

# Media library — local disk storage (images for anime covers, etc.)
# MEDIA_STORAGE_PATH=./data/uploads
# MEDIA_PUBLIC_BASE_URL=https://api.shiori.cloud
# MEDIA_MAX_UPLOAD_BYTES=10485760
