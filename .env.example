APP_PORT=4001
APP_HOST=0.0.0.0
APP_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3001

# Postgres — same DB as Supabase (direct connection string) or local docker-compose
DATABASE_URL=postgresql://shiori:shiori@localhost:5433/shiori

# Never enable in production against a live DB
DATABASE_SYNC=false

# Telegram Mini App — verify initData (same BotFather token as Supabase Edge)
TELEGRAM_BOT_TOKEN=

# نام کاربری بات (لینک startapp برای اتصال حساب وب)
# TELEGRAM_BOT_USERNAME=ShioriUploadBot

# URL مینی‌اپ برای دکمه «مشاهده در شیوری» در اعلان Telegram
# MINI_APP_URL=https://your-shiori-app.example.com

# Cron — جایگزین Supabase Edge sync-external-scores
# CRON_SECRET=your-random-secret
# OMDB_API_KEY=

# Media library — local disk storage (images for anime covers, etc.)
# MEDIA_STORAGE_PATH=./data/uploads
# MEDIA_PUBLIC_BASE_URL=http://localhost:4001
# MEDIA_MAX_UPLOAD_BYTES=10485760

# ─── Supabase → local copy (scripts/copy-from-supabase.sh) ───
# Database password from Supabase Dashboard → Settings → Database
# SUPABASE_DB_PASSWORD=
# Optional overrides:
# SUPABASE_PROJECT_REF=olscbzxwcddwumxispst
# SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
# LOCAL_DATABASE_URL=postgresql://shiori:shiori@localhost:5433/shiori
