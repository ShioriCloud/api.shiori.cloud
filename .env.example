APP_PORT=3000
APP_HOST=0.0.0.0
APP_ALLOW_ORIGINS=https://shiori.cloud,https://dash.shiori.cloud,http://localhost:5173

# Postgres
# ── Local dev (API on host, DB in docker-compose.yml): ──
# DATABASE_URL=postgresql://shiori:shiori@localhost:5433/shiori
#
# ── Production Docker (docker-compose.prod.yml): leave unset or comment out —
# compose sets DATABASE_URL=...@postgres:5432 automatically.
# DATABASE_URL=

# Never enable in production against a live DB
DATABASE_SYNC=false

# Telegram Mini App — verify initData (BotFather token)
TELEGRAM_BOT_TOKEN=

# نام کاربری بات (لینک startapp برای اتصال حساب وب)
# TELEGRAM_BOT_USERNAME=ShioriUploadBot

# URL مینی‌اپ برای دکمه «مشاهده در شیوری» در اعلان Telegram
# MINI_APP_URL=https://your-shiori-app.example.com

# Cron — external score sync
# CRON_SECRET=your-random-secret
# OMDB_API_KEY=

# Telegram bot backend API (tel-bot → x-bot-token header)
BOT_API_TOKEN='n~cJO/jry6^&DU1wHFP^un4Jxvg-9[w4'

# Media library — local disk storage (images for anime covers, etc.)
# MEDIA_STORAGE_PATH=./data/uploads
# MEDIA_PUBLIC_BASE_URL=https://api.shiori.cloud
# MEDIA_MAX_UPLOAD_BYTES=10485760
